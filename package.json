{
  "name": "cay-ocagi-kaosu",
  "version": "3.0.0",
  "private": true,
  "description": "3D Çay Ocağı Kaosu: Mahalle Meydanı — TikTok Live kontrollü, prosedürel sesli Three.js oyunu",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
